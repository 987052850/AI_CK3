entity = {
	name = "ep1_western_candles_entity"
	pdxmesh = "ep1_western_candles_mesh"
}

entity = {
	name = "ep1_western_candle_01_a_entity"
	pdxmesh = "ep1_western_candle_01_a_mesh"
	default_state = "idle"
       state = 
	   { 
			name = "idle" state_time = 5 looping = yes
			event = 
			{ 
				sound = { soundeffect = "event:/DLC/EP1/SFX/Ambience/3D/Objects/courtroom/candle" } 	
			}
			event =
			{
				time = 0
				node = "Candleflame_01"
				particle = "roco_candle"
				trigger_once = yes
				keep_particle = yes
			}
			event =
			{
				time = 0
				node = "Candleflame_02"
				particle = "roco_candle"
				trigger_once = yes
				keep_particle = yes
			}
			event =
			{
				time = 0
				node = "Candleflame_03"
				particle = "roco_candle"
				trigger_once = yes
				keep_particle = yes
			}
			event =
			{
				time = 0
				node = "Candleflame_04"
				particle = "roco_candle"
				trigger_once = yes
				keep_particle = yes
			}
			event =
			{
				time = 0
				node = "Candleflame_05"
				particle = "roco_candle"
				trigger_once = yes
				keep_particle = yes
			}

       }
}

