##### Rock -----------------------------------------

pdxmesh = {
	name = "ep1_generic_rock_01_a_mesh"
	file = "ep1_generic_rock_01_a.mesh"

	lod_percentages = {
		lod = { index = 1 percent = 12.0 }
		lod = { index = 2 percent = 4.0 }
	}

	meshsettings = {
		name = "ep1_generic_rock_01_a_LOD0Shape"
		index = 0
		texture_diffuse = "ep1_generic_rock_01_a_diffuse.dds"
		texture_normal = "ep1_generic_rock_01_a_normal.dds"
		texture_specular = "ep1_generic_rock_01_a_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}

	meshsettings = {
		name = "ep1_generic_rock_01_a_LODShape1"
		index = 0
		texture_diffuse = "ep1_generic_rock_01_a_diffuse.dds"
		texture_normal = "ep1_generic_rock_01_a_normal.dds"
		texture_specular = "ep1_generic_rock_01_a_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}

	meshsettings = {
		name = "ep1_generic_rock_01_a_LODShape2"
		index = 0
		texture_diffuse = "ep1_generic_rock_01_a_diffuse.dds"
		texture_normal = "ep1_generic_rock_01_a_normal.dds"
		texture_specular = "ep1_generic_rock_01_a_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}
}

