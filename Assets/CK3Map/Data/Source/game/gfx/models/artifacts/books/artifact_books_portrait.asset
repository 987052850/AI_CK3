##### Books -----------------------------------------

pdxmesh = {
	name = "ep1_mena_book_big_01_a_portrait_mesh"
	file = "ep1_mena_book_big_01_a_portrait.mesh"

	lod_percentages = {
		lod = { index = 1 percent = 15.0 }
		lod = { index = 2 percent = 6.0 }
	}

	meshsettings = {
		name = "ep1_mena_book_big_01_a_portrait_LOD0Shape"
		index = 0
		texture_diffuse = "ep1_mena_book_big_01_a_diffuse.dds"
		texture_normal = "ep1_mena_book_big_01_a_normal.dds"
		texture_specular = "ep1_mena_book_big_01_a_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "ep1_mena_book_big_01_a_portrait_LOD1Shape"
		index = 0
		texture_diffuse = "ep1_mena_book_big_01_a_diffuse.dds"
		texture_normal = "ep1_mena_book_big_01_a_normal.dds"
		texture_specular = "ep1_mena_book_big_01_a_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "ep1_mena_book_big_01_a_portrait_LOD2Shape"
		index = 0
		texture_diffuse = "ep1_mena_book_big_01_a_diffuse.dds"
		texture_normal = "ep1_mena_book_big_01_a_normal.dds"
		texture_specular = "ep1_mena_book_big_01_a_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

pdxmesh = {
	name = "ep1_western_book_big_01_a_portrait_mesh"
	file = "ep1_western_book_big_01_a_portrait.mesh"

	meshsettings = {
		name = "ep1_western_book_big_01_a_portraitShape"
		index = 0
