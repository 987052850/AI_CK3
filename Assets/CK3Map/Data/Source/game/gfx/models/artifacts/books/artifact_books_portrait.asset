		texture_normal = "ep1_western_book_big_01_a_normal.dds"
		texture_specular = "ep1_western_book_big_01_a_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

