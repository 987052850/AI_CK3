## Table
pdxmesh = {
	name = "mpo_steppe_table_mesh"
	file = "mpo_steppe_table.mesh"

	meshsettings = {
		name = "mpo_steppe_tableShape"
		index = 0
		texture_diffuse = "mpo_steppe_table_diffuse.dds"
		texture_normal = "mpo_steppe_table_normal.dds"
		texture_specular = "mpo_steppe_table_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}

}

entity = {
	name = "mpo_steppe_table_entity"
	pdxmesh = "mpo_steppe_table_mesh"
}

## Tugs
pdxmesh = {
	name = "mpo_steppe_tug_01_mesh"
	file = "mpo_steppe_tug_01.mesh"

	lod_percentages = {
		lod = { index = 1 percent = 20.0 }
		lod = { index = 2 percent = 10.0 }
	}

	meshsettings = {
		name = "mpo_steppe_tug_01_LOD0Shape"
		index = 0
		texture_diffuse = "mpo_steppe_tugs_diffuse.dds"
		texture_normal = "mpo_steppe_tugs_normal.dds"
