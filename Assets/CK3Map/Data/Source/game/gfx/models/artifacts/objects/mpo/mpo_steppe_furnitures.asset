		texture_specular = "mpo_steppe_tugs_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	meshsettings = {
		name = "mpo_steppe_tug_01_LOD1Shape"
		index = 0
		texture_diffuse = "mpo_steppe_tugs_diffuse.dds"
		texture_normal = "mpo_steppe_tugs_normal.dds"
		texture_specular = "mpo_steppe_tugs_properties.dds"
		shader = "court_pattern"
		shader_file = "gfx/FX/court_scene.shader"
	}
	meshsettings = {
		name = "mpo_steppe_tug_01_hair_LOD1Shape"
		index = 0
		texture_diffuse = "mpo_steppe_tugs_diffuse.dds"
		texture_normal = "mpo_steppe_tugs_normal.dds"
		texture_specular = "mpo_steppe_tugs_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	meshsettings = {
		name = "mpo_steppe_tug_01_LOD2Shape"
		index = 0
		texture_diffuse = "mpo_steppe_tugs_diffuse.dds"
		texture_normal = "mpo_steppe_tugs_normal.dds"
		texture_specular = "mpo_steppe_tugs_properties.dds"
		shader = "court_pattern"
		shader_file = "gfx/FX/court_scene.shader"
	}
	meshsettings = {
		name = "mpo_steppe_tug_01_hair_LOD2Shape"
		index = 0
		texture_diffuse = "mpo_steppe_tugs_diffuse.dds"
		texture_normal = "mpo_steppe_tugs_normal.dds"
		texture_specular = "mpo_steppe_tugs_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

}

entity = {
	name = "mpo_steppe_tug_01_entity"
	pdxmesh = "mpo_steppe_tug_01_mesh"
	
	game_data = {
        portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/artifacts/objects/mpo/mpo_steppe_tugs_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "mpo_steppe_royal_court_scarfs"	#A "variation" object in gfx/portraits/accessory_variations/
			}
        }
	}
}

